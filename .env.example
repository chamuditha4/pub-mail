# Copy to .env for local tooling reference. Worker runtime config lives in
# each app's wrangler.toml [vars]; secrets are set via `wrangler secret put`.
# Never commit real secrets (CLAUDE.md §19, §20).

APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787
DEFAULT_INBOX_TTL_SECONDS=3600
MIN_INBOX_TTL_SECONDS=600
MAX_INBOX_TTL_SECONDS=86400
MAX_MESSAGE_BYTES=15728640

# Secrets (set as Worker secrets in staging/production).
TOKEN_PEPPER=replace-with-32+char-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
WEBHOOK_SECRET_ENCRYPTION_KEY=
